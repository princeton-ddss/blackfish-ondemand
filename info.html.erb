<% require 'erb' %>
<% unless completed? %>
<% status_path = staged_root.join('launch-status.txt') %>
<% if queued? %>
<p role="status"><strong>Status:</strong> Waiting for a cluster node. Blackfish setup begins when the job starts.</p>
<% elsif status_path.file? %>
<p><strong>Status:</strong></p>
<pre class="pre-scrollable" role="log" aria-label="Blackfish launch log"><%= ERB::Util.html_escape(status_path.readlines.last(40).join.strip) %></pre>
<% else %>
<p role="status"><strong>Status:</strong> Preparing to launch Blackfish.</p>
<% end %>
<% end %>
