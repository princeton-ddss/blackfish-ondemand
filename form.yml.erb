<%
require 'json'
app_root = File.expand_path(__dir__)
require File.join(app_root, 'lib/site_config')
site = BlackfishSiteConfig.load(app_root)
%>
---
cluster: <%= site.fetch('cluster').to_json %>
form:
  - bc_num_hours
  - blackfish_version
  - home_dir
attributes:
  bc_num_hours:
    value: <%= site.fetch('duration_hours').fetch('default') %>
<% if site.fetch('duration_hours')['max'] %>
    max: <%= site.fetch('duration_hours').fetch('max') %>
<% end %>
    label: "Duration"
    help: "Time in hours to run the server for."
  blackfish_version:
    widget: select
    label: "Blackfish Version"
    value: <%= site.fetch('default').to_json %>
    options:
<% site.fetch('versions').each_key do |version| %>
      - <%= [version, version].to_json %>
<% end %>
    help: "Choose a shared installation. When switching versions, use a separate home directory to avoid incompatible database migrations."
  home_dir:
    widget: text_field
    value: <%= File.join(Dir.home, '.blackfish').to_json %>
    label: "Blackfish Home Directory"
    required: true
    help: "Absolute path to store application data (database, settings, etc.)."
