<%
require 'json'
app_root = File.expand_path(__dir__)
require File.join(app_root, 'lib/installations')
installations = BlackfishInstallations.load(app_root)
%>
---
cluster: "della-vis2"
form:
  - bc_num_hours
  - blackfish_version
  - home_dir
attributes:
  bc_num_hours:
    value: 1
    label: "Duration"
    help: "Time in hours to run the server for."
  blackfish_version:
    widget: select
    label: "Blackfish Version"
    value: <%= installations.fetch('default').to_json %>
    options:
<% installations.fetch('versions').each_key do |version| %>
      - <%= [version, version].to_json %>
<% end %>
    help: "Choose a shared installation. When switching versions, use a separate home directory to avoid incompatible database migrations."
  home_dir:
    widget: text_field
    value: <%= File.join(Dir.home, '.blackfish').to_json %>
    label: "Blackfish Home Directory"
    required: true
    help: "Absolute path for your database, settings, and the initial profile's working files. A Default profile is created only if no profiles exist; existing profiles and your default selection are preserved."
