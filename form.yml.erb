# ~/ondemand/dev/blackfish/form.yml
---
cluster: "della-vis2"
form:
  - bc_num_hours
  - cache_dir
attributes:
  bc_num_hours:
    value: 1
    label: "Duration"
    help: "Time in hours to run the server for."
  cache_dir:
    value: "/scratch/gpfs/ddsscloud/.blackfish"
    label: "Cache Directory"
    help: "Location to look for shared model and image file."