#!/usr/bin/env bash
<%
require 'shellwords'
require session.app.root.join('lib/installations').to_s
installations = BlackfishInstallations.load(session.app.root)
%>

set +x
set -eE -o pipefail
umask 077
source "$(dirname "${BASH_SOURCE[0]}")/launch_helpers.sh"
trap 'launch_fail "Blackfish initialization or server process exited with an error"' ERR

export BLACKFISH_HOME_DIR=<%= Shellwords.escape(context.home_dir.to_s) %>
cache_dir=<%= Shellwords.escape(installations.fetch('cache_dir')) %>
[[ "$BLACKFISH_HOME_DIR" == /* ]] || launch_fail "Home directory must be an absolute path"

launch_status "Preparing Blackfish home directory"
mkdir -p -- "$BLACKFISH_HOME_DIR"
[[ -w "$BLACKFISH_HOME_DIR" && -x "$BLACKFISH_HOME_DIR" ]] || launch_fail "Home directory must be writable"

export BLACKFISH_BASE_PATH="/node/${host}/${port}"
# The proxy may resolve the node name to a different network interface than
# the node itself. Listen on all IPv4 interfaces; keep the node name in URLs.
export BLACKFISH_HOST="0.0.0.0"
export BLACKFISH_PORT="$port"
export BLACKFISH_DEBUG=0
export BLACKFISH_AUTH_TOKEN="$password"

launch_status "Checking Blackfish profiles"
python3 "$(dirname "${BASH_SOURCE[0]}")/prepare_profile.py" \
  --home-dir "$BLACKFISH_HOME_DIR" \
  --cache-dir "$cache_dir" \
  --user "$USER"

launch_status "Initializing Blackfish data"
"$BLACKFISH_EXECUTABLE" init --app-dir "$BLACKFISH_HOME_DIR" </dev/null

"$BLACKFISH_EXECUTABLE" profile show </dev/null || launch_fail "No usable default profile is available"

launch_status "Starting Blackfish server"
"$BLACKFISH_EXECUTABLE" start
