#!/usr/bin/env bash
<%
require 'shellwords'
require session.app.root.join('lib/site_config').to_s
site = BlackfishSiteConfig.for_session(session, context)
version = context.blackfish_version.to_s
installation = site.fetch('versions').fetch(version) do
  raise "Blackfish version #{version.inspect} is unavailable. Relaunch and select a listed version."
end
%>

# Do not trace credentials, even if tracing was enabled by the login environment.
set +x
umask 077
source "$(dirname "${BASH_SOURCE[0]}")/launch_helpers.sh" || exit 1
launch_status "Loading shared Blackfish <%= version %>"

# Keep user Python packages from shadowing the administrator's installation.
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
unset PYTHONPATH PYTHONHOME

<% unless installation.fetch('modules', []).empty? %>
if ! type module >/dev/null 2>&1; then
  if [[ -r /etc/profile.d/modules.sh ]]; then
    source /etc/profile.d/modules.sh || launch_fail "Could not initialize environment modules"
  else
    launch_fail "Environment modules are unavailable"
  fi
fi
module purge || launch_fail "Could not reset environment modules"
module load <%= installation.fetch('modules').map { |name| Shellwords.escape(name) }.join(' ') %> || launch_fail "Could not load Blackfish modules"
[[ $(type -t module) != function ]] || export -f module
<% end %>

export BLACKFISH_EXECUTABLE=<%= Shellwords.escape(installation.fetch('executable')) %>
export BLACKFISH_SELECTED_VERSION=<%= Shellwords.escape(version) %>
BLACKFISH_EXECUTABLE=$(command -v "$BLACKFISH_EXECUTABLE") || launch_fail "The selected shared installation is unavailable; contact the app administrator"
[[ -x "$BLACKFISH_EXECUTABLE" ]] || launch_fail "The selected Blackfish executable cannot be run"
if ! installed_version=$("$BLACKFISH_EXECUTABLE" version); then
  launch_fail "Could not query the installed Blackfish version"
fi
if [[ "$(printf '%s\n' "$installed_version" | tail -n 1)" != "blackfish-ai ${BLACKFISH_SELECTED_VERSION}" ]]; then
  launch_fail "The shared installation does not match the selected version"
fi

launch_status "Allocating a server port"
command -v curl >/dev/null 2>&1 || launch_fail "curl is required to check server readiness"
port=$(find_port) || launch_fail "Could not allocate a port"
[[ "$port" =~ ^[0-9]+$ ]] || launch_fail "Invalid allocated port"
export port
export password
password=$(create_passwd 32) || launch_fail "Could not generate an authentication token"
[[ "$password" =~ ^[a-zA-Z0-9]{32}$ ]] || launch_fail "Invalid authentication token"
