# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module
[[ x$(type -t module) != "xfunction" && -e /etc/profile.d/modules.sh ]] && source /etc/profile.d/modules.sh

# Find available port to run server on
echo "Finding a port..."
port=$(find_port)
echo "> using port ${port}"

# Generate SHA1 encrypted password (requires OpenSSL installed)
SALT="$(create_passwd 16)"
password="$(create_passwd 16)"
PASSWORD_SHA1="$(echo -n "${password}${SALT}" | openssl dgst -sha1 | awk '{print $NF}')"

# Build Blackfish UI
echo "Building next.js in <%= session.staged_root %>..."
suffix=".princeton.edu"
export NEXT_PUBLIC_BLACKFISH_DOMAIN="mydella.princeton.edu/rnode"
export NEXT_PUBLIC_BLACKFISH_HOST="${host%$suffix}"
export NEXT_PUBLIC_BLACKFISH_PORT="${port}"
staged_root="<%= session.staged_root %>"
echo "> NEXT_PUBLIC_BLACKFISH_DOMAIN=${NEXT_PUBLIC_BLACKFISH_DOMAIN}"
echo "> NEXT_PUBLIC_BLACKFISH_HOST=${NEXT_PUBLIC_BLACKFISH_HOST}"
echo "> NEXT_PUBLIC_BLACKFISH_PORT=${NEXT_PUBLIC_BLACKFISH_PORT}"
mkdir -p "${staged_root}/static/build"
mkdir -p "${staged_root}/static/.next"
echo "> starting apptainer..."
apptainer run \
  --env "ASSET_PREFIX=/rnode/${host}/${port}" \
  --env "BASE_PATH=/rnode/${host}/${port}" \
  --cwd /app \
  --bind "${staged_root}/static/build:/app/build" \
  --bind "${staged_root}/static/.next:/app/.next" \
  /home/cs7101/images/blackfish-ui_ondemand-latest.sif
echo "> done."
echo "> cleaning up..."
cp -R ${staged_root}/static/build/out/* ${staged_root}/static/build
rm -rf "${staged_root}/static/build/out"
echo "> done."
echo "Finished building next.js.\n"

# Create Blackfish home directory
if [ ! -d "${HOME}/.blackfish-ondemand" ]; then
  mkdir -p "${HOME}/.blackfish-ondemand"
fi

  # Set Blackfish environment variables
echo "Setting Blackfish environment variables..."
export BLACKFISH_HOST="${NEXT_PUBLIC_BLACKFISH_HOST}"
export BLACKFISH_PORT="${NEXT_PUBLIC_BLACKFISH_PORT}"
export BLACKFISH_STATIC_DIR="${staged_root}/static"
export BLACKFISH_HOME_DIR="$HOME/.blackfish-ondemand"
export BLACKFISH_TOKEN=u'sha1:${SALT}:${PASSWORD_SHA1}'
echo "> BLACKFISH_HOST=${BLACKFISH_HOST}"
echo "> BLACKFISH_PORT=${BLACKFISH_PORT}"
echo "> BLACKFISH_STATIC_DIR=${BLACKFISH_STATIC_DIR}"
echo "> BLACKFISH_HOME_DIR=${BLACKFISH_HOME_DIR}"
echo "> BLACKFISH_TOKEN=${BLACKFISH_TOKEN}\n"