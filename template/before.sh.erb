#!/usr/bin/env bash

# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module
[[ x$(type -t module) != "xfunction" && -e /etc/profile.d/modules.sh ]] && source /etc/profile.d/modules.sh

if [[ "${PWD}" == */dev/blackfish-ondemand* ]]; then
  export STAGED_ENV="dev"
  printf "Deploying development app (STAGED_ENV=${STAGED_ENV}).\n"
else
  export STAGED_ENV="share"
  printf "Deploying production app (STAGED_ENV=${STAGED_ENV}).\n"
fi

export APP_DIR="/home/cs7101/ondemand/${STAGED_ENV}/blackfish-ondemand"
export BLACKFISH_VERSION=$(cat "${APP_DIR}/.blackfish-version")

printf "Loading required modules...\n"
module purge
module load anaconda3/2024.6

printf "Setting up user environment...\n"
export USER_ENV="${HOME}/.blackfish-ondemand/.venv"
if [ ! -d "${USER_ENV}" ]; then
  printf "Creating conda environment at ${USER_ENV}...\n"
  conda create --prefix "${USER_ENV}" python=3.12 --yes
fi
conda activate "${USER_ENV}"

printf "Installing blackfish-ai${BLACKFISH_VERSION}...\n"
pip install "blackfish-ai${BLACKFISH_VERSION}"
printf "done.\n"

printf "Finding an available port..."
port=$(find_port)
printf "done. Using port ${port}\n"

printf "Generating password..."
export password="$(create_passwd 16)"
printf "done.\n"
