# Wait for the Blackfish server to start
printf "Waiting for Blackfish server to open port ${port}...\n"
if wait_until_port_used "${host}:${port}" 60; then
  printf "Blackfish server listening on port ${port}!\n"
else
  printf "Timed out waiting for Blackfish server to open port ${port}!\n"
  pkill -P ${SCRIPT_PID}
  clean_up 1
fi
sleep 2